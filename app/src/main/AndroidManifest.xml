<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Required by app discovery and generic cross-app automation. BlackClaw is
         sideloaded rather than distributed under Play's restricted policy. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Custom permission guarding the external automation entrypoints.

         WHY: .automation.ExternalAutomationActivity and
         .automation.ExternalAutomationReceiver were exported with no permission at
         all. Reaching them starts an arbitrary agent task, and an agent task can
         read the screen, notifications, SMS and clipboard and then call tools — so
         an unguarded export is a full remote-control channel for any installed app
         holding zero permissions of its own.

         ExternalAutomationEntrypoint.isTargetedToBlackClaw() looked like a gate but
         is not one: it inspects where the intent is going, not where it came from,
         so any app satisfies it with intent.setPackage("com.blackclaw.android").
         And the user-facing enable switch is a single global boolean, so turning it
         on for one automation app turned it on for all of them.

         protectionLevel="signature" means the system only grants this to apps signed
         with the same key, and it enforces that before our process is even woken —
         which is the property no in-app check can provide. Cost is stated in the
         report: third-party automation apps (Tasker, MacroDroid) cannot hold a
         signature permission, so they are blocked at this layer. The per-caller
         allowlist in KVUtils narrows callers that DO hold it. -->
    <permission
        android:name="com.blackclaw.android.permission.AUTOMATION"
        android:protectionLevel="signature"
        android:label="@string/app_name" />
    <uses-permission android:name="com.blackclaw.android.permission.AUTOMATION" />

    <!-- Device features -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.concurrent"
        android:required="false" />

    <!-- Android Auto (Car App Library). Not required so phones without a car
         connection still install the app. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <application
        android:name=".ClawApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlackClaw">

        <!-- ── Android Auto (Car App Library) ──────────────────────────────
             Voice-first assistant surface for the car head unit / phone
             projection. minCarApiLevel 1 = works on all Android Auto hosts. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".car.BlackClawCarAppService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- 启动页 -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlackClaw.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".ui.chat.ComposeChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.ThemeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.EmergencySettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.MemoryPrivacyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.EmergencyEvidenceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.EmergencyEvidencePlayerActivity"
            android:exported="false" />
        <activity
            android:name=".knowledge.ZimLibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.skills.SkillsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.scheduled.ScheduledTasksActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.scheduled.AutomationProfileEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.tools.ToolBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.autoreply.AutoRepliesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.shizuku.ShizukuSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.adb.AdbProActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.terminal.TerminalActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.security.SecurityActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.proactive.ProactiveAssistantActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.VoiceSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.guide.FeaturesGuideActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.assistant.AssistantActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.assistant.CalendarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.assist.QuickAssistActivity"
            android:exported="true"
            android:theme="@style/Theme.BlackClaw.Assist"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Native default-assistant contract.  The session receives Android's
             pre-overlay AssistStructure/screenshot; QuickAssist then renders the
             conversation panel without losing the app the user was looking at. -->
        <service
            android:name=".ui.assist.BlackClawVoiceInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".ui.assist.BlackClawVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Required by the voice-interaction XML on Android 11 and earlier.
             Interactive dictation remains in the visible QuickAssist panel. -->
        <service
            android:name=".ui.assist.BlackClawRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
        <activity
            android:name=".assistant.AlarmRingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BlackClaw" />
        <activity
            android:name=".perception.ScreenCapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent" />
        <service
            android:name=".perception.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".service.VoiceWakeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".service.VoiceTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="Voz BlackClaw"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shizuku provider — required by Shizuku-API to hand the user's binder
             to BlackClaw. We do NOT enable Shizuku itself here, that's the user's
             separate app. This entry is just the IPC bridge. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name=".ui.settings.LlmConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.ChannelConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".tool.impl.ClipboardReaderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />
        <!-- Caller must hold com.blackclaw.android.permission.AUTOMATION (signature).
             The activity deliberately does NOT carry that permission. A signature
             permission is enforced by the system before our code runs, so a
             third-party automation app (Tasker, MacroDroid) could never reach us at
             all — and driving BlackClaw from Tasker is a documented feature, not an
             oversight to close. Instead the activity enforces consent in code, in
             AutomationCallerPolicy: a valid AutomationToken (a secret the user copies
             out of Settings), or a caller package on the user's allowlist. Both are
             things an attacking app cannot produce. Note getCallingPackage() is null
             for the plain startActivity that Tasker uses, which is exactly why the
             token exists and why an origin-only rule was not sufficient. -->
        <activity
            android:name=".automation.ExternalAutomationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="com.blackclaw.android.RUN_TASK" />
                <action android:name="com.blackclaw.android.RUN_CHAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- The broadcast path gets NO per-caller check: a BroadcastReceiver is never
             told who sent the broadcast. The signature permission below is therefore
             the whole of the access control here, not a first layer of it. -->
        <receiver
            android:name=".automation.ExternalAutomationReceiver"
            android:exported="true"
            android:permission="com.blackclaw.android.permission.AUTOMATION">
            <intent-filter>
                <action android:name="com.blackclaw.android.RUN_TASK" />
                <action android:name="com.blackclaw.android.RUN_CHAT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.ClawNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ClawAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.ForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".emergency.EmergencyService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location|specialUse" />
        <service
            android:name=".knowledge.ZimIndexService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".emergency.EmergencyReceiver"
            android:exported="false" />

        <!-- 定时守护 -->
        <service
            android:name=".service.KeepAliveJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 开机自启动 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Tasker-like system triggers. The receiver only emits typed local events;
             each profile still applies its own conditions, cooldown and limits. -->
        <receiver
            android:name=".automation.AutomationSystemReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.AutomationProfileTimeReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- External Tasker-compatible trigger. The profile token is checked by the
             receiver and the local engine applies the remaining safety limits. -->
        <receiver
            android:name=".automation.AutomationWebhookReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.blackclaw.android.AUTOMATION_WEBHOOK" />
            </intent-filter>
        </receiver>


        <!-- Scheduled tasks (cron-style) — fired by AlarmManager -->
        <receiver
            android:name=".scheduler.ScheduledTaskReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.blackclaw.android.SCHEDULED_TASK" />
            </intent-filter>
        </receiver>

        <!-- Native Assistant hub — reminders/alarms/events fired by AlarmManager -->
        <receiver
            android:name=".assistant.AssistantReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.blackclaw.android.ASSISTANT_FIRE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".assistant.AssistantDecisionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.blackclaw.android.DECISION_YES" />
                <action android:name="com.blackclaw.android.DECISION_NO" />
            </intent-filter>
        </receiver>

        <!-- Proactive daily briefings (morning/night) fired by AlarmManager -->
        <receiver
            android:name=".proactive.BriefingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.blackclaw.android.BRIEFING_FIRE" />
            </intent-filter>
        </receiver>

        <!-- Assistant home-screen widget -->
        <receiver
            android:name=".assistant.AssistantWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/assistant_widget_info" />
        </receiver>

        <!-- Assistant Quick Settings tile -->
        <service
            android:name=".assistant.AssistantTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="Asistente"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
